  {
   "id": 9,
   "type": "table",
   "title": "Latest alerts (recommendations for analyst review)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_POSTGRES}"
   },
   "gridPos": {
    "x": 8,
    "y": 13,
    "w": 16,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_POSTGRES}"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT a.txn_id, s.type, round(s.amount::numeric) AS amount, round(s.fraud_score::numeric,2) AS ml_score, a.risk_score AS llm_risk, a.action, a.rationale FROM alerts a JOIN scored_txns s USING (txn_id) ORDER BY a.created_ts DESC LIMIT 20"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "cellOptions": {
       "type": "auto"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "action"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "recommend_block": {
            "color": "#B8643A",
            "index": 0
           },
           "hold_for_review": {
            "color": "#B58B63",
            "index": 1
           },
           "contact_customer": {
            "color": "#8A7F72",
            "index": 2
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "rationale"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto",
         "wrapText": true
        }
       },
       {
        "id": "custom.width",
        "value": 420
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "md"
   }
