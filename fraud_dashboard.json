  {
   "id": 6,
   "type": "barchart",
   "title": "Flagged per minute",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "${DS_POSTGRES}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_POSTGRES}"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT to_char(date_trunc('minute', to_timestamp(scored_ts) AT TIME ZONE 'Asia/Kolkata'),'HH24:MI') AS minute, sum(flagged)::int AS flagged FROM scored_txns GROUP BY 1 ORDER BY 1"
