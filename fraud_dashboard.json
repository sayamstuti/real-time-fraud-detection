      "uid": "${DS_POSTGRES}"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT count(*)::int AS scored FROM scored_txns"
    }
   ],
   "fieldConfig": {
