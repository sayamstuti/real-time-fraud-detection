     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT coalesce(sum((action='recommend_block')::int),0)::int AS recommend_block, coalesce(sum((action='hold_for_review')::int),0)::int AS hold_for_review, coalesce(sum((action='contact_customer')::int),0)::int AS contact_customer FROM alerts"
